{
  "name": "@svelterun/adapter-auto",
  "version": "1.0.0-next.3",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": {
    "name": "Nicholas Berlette",
    "email": "nick@berlette.com"
  },
  "homepage": "https://adapters.svelte.run",
  "repository": "svelterun/adapter-auto",
  "readme": "https://github.com/svelterun/adapter-auto#readme",
  "bugs": "https://github.com/svelterun/adapter-auto/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "node": "./index.js",
      "default": "./index.js"
    },
    "./adapters": {
      "import": "./adapters.js",
      "default": "./adapters.js"
    },
    "./package.json": "./package.json"
  },
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "adapters.js",
    "package.json",
    "license",
    "README.md"
  ],
  "eslintConfig": {
    "root": true,
    "extends": "@sveltejs",
    "parserOptions": {
      "sourceType": "module"
    },
    "settings": {
      "import/ignore": "/template/"
    }
  },
  "prettier": {
    "useTabs": false,
    "tabSize": 2,
    "trailingComma": "es5",
    "semi": true,
    "singleQuote": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "printWidth": 80
  },
  "dependencies": {
    "@sveltejs/adapter-cloudflare": "next",
    "@sveltejs/adapter-cloudflare-workers": "next",
    "@sveltejs/adapter-netlify": "next",
    "@sveltejs/adapter-static": "next",
    "@sveltejs/adapter-vercel": "next"
  },
  "scripts": {
    "lint": "eslint --ignore-path .gitignore \"**/*.{ts,js,svelte}\"",
    "lint:fix": "npm run eslint -- --fix", 
    "prettier": "prettier --ignore-path .gitignore \"**/*.{ts,js,svelte}\"",
    "fmt": "npm run prettier -- --write",
    "fmt:check": "npm run prettier -- --check"
  }
}
